<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="KnsMigrator.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.SqlServer.Types" publicKeyToken="89845dcd8080cc91" />
        <bindingRedirect oldVersion="1.0.0.0-15.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <connectionStrings>
    <add name="KnsMigratorConnection" connectionString="Data Source=ZPROGLEX;Initial Catalog=RupIntegrator_lan;Integrated Security=SSPI;" providerName="System.Data.SqlClient"/>
    <add name="KnsMigratorEntities" connectionString="metadata=res://*/MigratorEDModel.csdl|res://*/MigratorEDModel.ssdl|res://*/MigratorEDModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=ZPROGLEX;Initial Catalog=RupIntegrator_lan;Integrated Security=SSPI;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>

    <add name="RupIntegratorEntities" connectionString="metadata=res://*/BIGModel.csdl|res://*/BIGModel.ssdl|res://*/BIGModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=ZPROGLEX;Initial Catalog=RupIntegrator_lan;Integrated Security=SSPI;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="KnsMigrator.Properties.Settings.KnsMigratorConnectionString" connectionString="Data Source=ZPROGLEX;Initial Catalog=RupIntegrator_lan;Integrated Security=SSPI;" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/>
  </startup>
  <system.serviceModel>
    <bindings>
      <customBinding>
        <binding name="Ex2PSCDBinding">
          <textMessageEncoding maxReadPoolSize="64" maxWritePoolSize="16" messageVersion="Soap11" writeEncoding="utf-8">
            <readerQuotas maxDepth="10000000" maxStringContentLength="10000000" maxArrayLength="67108864" maxBytesPerRead="65536" maxNameTableCharCount="100000"/>
          </textMessageEncoding>
          <httpsTransport authenticationScheme="Basic" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" keepAliveEnabled="false" maxBufferSize="2147483647" 		proxyAuthenticationScheme="Basic" realm="XISOAPApps" useDefaultWebProxy="true" maxReceivedMessageSize="2147483647" requireClientCertificate="true"   />
        </binding>
        <binding name="Ex2BIGBinding">
          <textMessageEncoding maxReadPoolSize="64" maxWritePoolSize="16" messageVersion="Soap11" writeEncoding="utf-8">
            <readerQuotas maxDepth="10000000" maxStringContentLength="10000000" maxArrayLength="67108864" maxBytesPerRead="65536" maxNameTableCharCount="100000"/>
          </textMessageEncoding>
          <httpsTransport authenticationScheme="Basic" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" keepAliveEnabled="false" maxBufferSize="2147483647" 		proxyAuthenticationScheme="Basic" realm="XISOAPApps" useDefaultWebProxy="true" maxReceivedMessageSize="2147483647"  />
        </binding>
        <binding name="CustomHttpTransportBinding">
          <textMessageEncoding maxReadPoolSize="64" maxWritePoolSize="16"
            messageVersion="Soap11" writeEncoding="utf-8">
            <readerQuotas maxDepth="10000000" maxStringContentLength="10000000"
              maxArrayLength="67108864" maxBytesPerRead="65536" maxNameTableCharCount="100000"  />
          </textMessageEncoding>
          <httpsTransport authenticationScheme="Basic" bypassProxyOnLocal="false"
            hostNameComparisonMode="StrongWildcard" keepAliveEnabled="false" maxBufferSize="2147483647"
            proxyAuthenticationScheme="Basic" realm="XISOAPApps" useDefaultWebProxy="true" maxReceivedMessageSize="2147483647" />
        </binding>
      </customBinding>
    </bindings>
    <client>
      <endpoint address="https://sapwitl01.zsrk.ms.gov.pl:44300/XISOAPAdapter/MessageServlet?senderParty=&amp;senderService=EX2PSCDSender&amp;receiverParty=&amp;receiverService=&amp;interface=PartnerQueryOut&amp;interfaceNamespace=urn%3Ams.gov.pl%3AEX2PSCD%3APartnerQuery"
      binding="customBinding" bindingConfiguration="Ex2PSCDBinding"
      contract="Ex2PscdPartnerQueryOutService.PartnerQueryOut" name="Ex2PSCDEndpoint" />

      <endpoint address="https://sapwitl01.zsrk.ms.gov.pl:44300/XISOAPAdapter/MessageServlet?senderParty=&amp;senderService=IG_SENDER_SYSTEMS_DEV&amp;receiverParty=&amp;receiverService=&amp;interface=IG2BIG_checkStatus_out&amp;interfaceNamespace=http%3A%2F%2Fms.gov.pl%2Fig2big%2Fcommon"
               binding="customBinding"
               bindingConfiguration="Ex2PSCDBinding1"
               contract="ServiceReferenceCheckStatus.IG2BIG_checkStatus_out"
               name="HTTPS_Status" />

      <endpoint address="https://sapmodl01.zsrk.ms.gov.pl:51100/XISOAPAdapter/MessageServlet?senderParty=&amp;senderService=IG_SENDER_SYSTEMS_DEV&amp;receiverParty=&amp;receiverService=&amp;interface=IG2BIG_packageSubmitRequest_out&amp;interfaceNamespace=http%3A%2F%2Fms.gov.pl%2Fig2big%2Fcommon"
                binding="customBinding"
                bindingConfiguration="CustomHttpTransportBinding"
                contract="ServiceReferenceBigMain.IG2BIG_packageSubmitRequest_out"
                name="HTTP_Package" />
    </client>
    
  </system.serviceModel>
  <applicationSettings>
    <KnsMigrator.Properties.Settings>
      <setting name="SAPExport" serializeAs="String">
        <value>YES</value>
      </setting>
    </KnsMigrator.Properties.Settings>
  </applicationSettings>
  <appSettings>
    <add key="testPO" value ="0"/>
  </appSettings>
</configuration>
