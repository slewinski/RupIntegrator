<log4net>
  <appender name="DOT_NET_APPENDER" type="log4net.Appender.RollingFileAppender">
    <filter type="log4net.Filter.LevelRangeFilter">
      <param name="LevelMin" value="DEBUG"/>
      <param name="LevelMax" value="ERROR"/>
    </filter>
    <file type="log4net.Util.PatternString" value="C:\\RupIntegrator\\logs\\RupLog_"/>
    <appendToFile value="true"/>
    <maximumFileSize value="10MB"/>
    <staticLogFileName value="false" />
    <datePattern value="dd.MM.yyyy'.log'" />
    <maxSizeRollBackups value="7" />
    <rollingStyle value="Date"/>
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [Thread %thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>
  <root>
    <appender-ref ref="DOT_NET_APPENDER" />
  </root>
</log4net>