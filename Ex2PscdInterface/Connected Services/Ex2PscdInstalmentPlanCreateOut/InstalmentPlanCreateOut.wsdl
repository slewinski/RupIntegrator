<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:p1="urn:ms.gov.pl:EX2PSCD:InstalmentPlanCreate" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy" name="InstalmentPlanCreateOut" targetNamespace="urn:ms.gov.pl:EX2PSCD:InstalmentPlanCreate" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
  <wsdl:documentation />
  <wsp:UsingPolicy wsdl:required="true" />
  <wsp:Policy wsu:Id="OP_InstalmentPlanCreateOut" />
  <wsdl:types>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:Common" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:complexType name="InstalmentPlanCreateRequest">
        <xsd:sequence>
          <xsd:element name="Admin" type="Admin" />
          <xsd:element name="KodWaluty">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="5" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="KluczUzgodnienia">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="DataKsiegowaniaPlanuRat">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="....-..-.." />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="TabelaPlanuRat" type="TabelaPlanuRat" />
          <xsd:element name="TabelaDokumentowPlanuRat" type="TabelaDokumentowPlanuRat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="PlanRat">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="NumerRaty">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{2}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="TerminPlatnosci">
            <xsd:annotation>
              <xsd:documentation>Data płatności netto</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="....-..-.." />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="KwotaPlatnosci">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="18" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Komunikaty">
        <xsd:sequence>
          <xsd:element minOccurs="0" maxOccurs="unbounded" name="Komunikat" type="Komunikat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Admin">
        <xsd:annotation>
          <xsd:documentation xml:lang="EN">Dane administracyjne dot. żądania</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="JednostkaGospodarcza">
            <xsd:annotation>
              <xsd:documentation>Numer jednostki gospodarczej (4 cyfry)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{4}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="IDKomunikatu" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Identyfikacja komunikatu</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="IDSystemMerytorycznego" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Identyfikacja systemu merytorycznego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="UtworzonyData">
            <xsd:annotation>
              <xsd:documentation>Data utworzenia komunikatu (format YYYYMMDD)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{8}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="UtworzonyGodz">
            <xsd:annotation>
              <xsd:documentation>Godzina utworzenia komunikatu (format HHMMSS)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{6}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Uzytkownik">
            <xsd:annotation>
              <xsd:documentation>Nazwa użytkownika na systemie ZSRK ERP FI</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\w{1" />
                <xsd:pattern value="12}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Haslo">
            <xsd:annotation>
              <xsd:documentation>Zaszyfrowane hasło użytkownika</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^[-A-Za-z0-9+\/]*={0" />
                <xsd:pattern value="3}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="TabelaPlanuRat">
        <xsd:sequence>
          <xsd:element maxOccurs="unbounded" name="PlanRat" type="PlanRat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Komunikat">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="IDKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Identyfikator żądania</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="RodzajKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Typ komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Numer komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{3}$" />
                <xsd:maxLength value="3" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="Komunikat">
            <xsd:annotation>
              <xsd:documentation>Tekstowa postać komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="240" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="TabelaDokumentowPlanuRat">
        <xsd:sequence>
          <xsd:element maxOccurs="unbounded" name="DokumentPlanuRat" type="DokumentPlanuRat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="InstalmentPlanCreateResponse">
        <xsd:sequence>
          <xsd:element name="NumerPlanuRat">
            <xsd:annotation>
              <xsd:documentation>Numer dokumentu rozrachunków wg kont umów</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Komunikaty" type="Komunikaty" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DokumentPlanuRat">
        <xsd:sequence>
          <xsd:element name="NumerDokumentuRozrachunkow">
            <xsd:annotation>
              <xsd:documentation>Numer dokumentu rozrachunków wg kont umów</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:InstalmentPlanCreate" xmlns:p1="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:InstalmentPlanCreate" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:import namespace="urn:ms.gov.pl:EX2PSCD:Common" />
      <xsd:element name="InstalmentPlanCreateResponse" type="p1:InstalmentPlanCreateResponse" />
      <xsd:element name="InstalmentPlanCreateRequest" type="p1:InstalmentPlanCreateRequest" />
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="InstalmentPlanCreateRequest">
    <wsdl:documentation />
    <wsdl:part name="InstalmentPlanCreateRequest" element="p1:InstalmentPlanCreateRequest" />
  </wsdl:message>
  <wsdl:message name="InstalmentPlanCreateResponse">
    <wsdl:documentation />
    <wsdl:part name="InstalmentPlanCreateResponse" element="p1:InstalmentPlanCreateResponse" />
  </wsdl:message>
  <wsdl:portType name="InstalmentPlanCreateOut">
    <wsdl:documentation />
    <wsdl:operation name="InstalmentPlanCreateOut">
      <wsdl:documentation />
      <wsp:Policy>
        <wsp:PolicyReference URI="#OP_InstalmentPlanCreateOut" />
      </wsp:Policy>
      <wsdl:input message="p1:InstalmentPlanCreateRequest" />
      <wsdl:output message="p1:InstalmentPlanCreateResponse" />
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="InstalmentPlanCreateOutBinding" type="p1:InstalmentPlanCreateOut">
    <binding transport="http://schemas.xmlsoap.org/soap/http" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
    <wsdl:operation name="InstalmentPlanCreateOut">
      <operation soapAction="http://sap.com/xi/WebService/soap1.1" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      <wsdl:input>
        <body use="literal" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      </wsdl:input>
      <wsdl:output>
        <body use="literal" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
</wsdl:definitions>