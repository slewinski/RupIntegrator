<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:p1="urn:ms.gov.pl:EX2PSCD:ContractAccountCreate" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy" name="ContractAccountCreateOut" targetNamespace="urn:ms.gov.pl:EX2PSCD:ContractAccountCreate" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
  <wsdl:documentation />
  <wsp:UsingPolicy wsdl:required="true" />
  <wsp:Policy wsu:Id="OP_ContractAccountCreateOut" />
  <wsdl:types>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:Common" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:complexType name="Komunikaty">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">cbc364503b8811ebb319000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element minOccurs="0" maxOccurs="unbounded" name="Komunikat" type="Komunikat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ContractAccountCreateRequest">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">0e61c426622c11ebcb27000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="Admin" type="Admin">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">0838e3155ca911ebb9b5025041000001</xsd:appinfo>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="KontoUmowy" type="KontoUmowyTworzenie">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">0838e3165ca911ebb09d025041000001</xsd:appinfo>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="AutomatyczneTworzenie">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a48704f65ca611eb9216025041000001</xsd:appinfo>
              <xsd:documentation>Automatyczne tworzenie</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Admin">
        <xsd:annotation>
          <xsd:documentation xml:lang="EN">Dane administracyjne dot. żądania</xsd:documentation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">256562f8622711eb82c8000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="JednostkaGospodarcza">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300d3b8511ebab5d025041000001</xsd:appinfo>
              <xsd:documentation>Numer jednostki gospodarczej (4 cyfry)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{4}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="IDKomunikatu" type="xsd:string">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300e3b8511ebae7d025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikacja komunikatu</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="IDSystemMerytorycznego" type="xsd:string">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300f3b8511eba995025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikacja systemu merytorycznego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="UtworzonyData">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e86630103b8511ebbb15025041000001</xsd:appinfo>
              <xsd:documentation>Data utworzenia komunikatu (format YYYYMMDD)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{8}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="UtworzonyGodz">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e86630113b8511eba551025041000001</xsd:appinfo>
              <xsd:documentation>Godzina utworzenia komunikatu (format HHMMSS)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{6}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Uzytkownik">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">5fbdeefa571211ebbbed025041000001</xsd:appinfo>
              <xsd:documentation>Nazwa użytkownika na systemie ZSRK ERP FI</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\w{1" />
                <xsd:pattern value="12}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Haslo">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">5fbdeefb571211eba86d025041000001</xsd:appinfo>
              <xsd:documentation>Zaszyfrowane hasło użytkownika</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^[-A-Za-z0-9+\/]*={0" />
                <xsd:pattern value="3}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Komunikat">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">1d18ad44622711ebabf6000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element minOccurs="0" name="IDKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929653b8811ebb7d1025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikator żądania</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="RodzajKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929663b8811ebbe05025041000001</xsd:appinfo>
              <xsd:documentation>Typ komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929673b8811eba8c3025041000001</xsd:appinfo>
              <xsd:documentation>Numer komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{3}$" />
                <xsd:maxLength value="3" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="Komunikat">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929683b8811ebbab2025041000001</xsd:appinfo>
              <xsd:documentation>Tekstowa postać komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="240" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="KontoUmowyIdentyfikacja">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">f9ff72ab5ca611ebadf9000006d9f6a6</xsd:appinfo>
