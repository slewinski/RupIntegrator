            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="2" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="JednostkaGospodarcza">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">9d207cee5ca611ebaa9a025041000001</xsd:appinfo>
              <xsd:documentation>Jednostka gospodarcza</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="4" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="StandardowaJednostkaGospodarcza">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">9d207cef5ca611ebb706025041000001</xsd:appinfo>
              <xsd:documentation>Standardowa jednostka gospodarcza</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="4" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="NumerPartnera">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">9d207cf05ca611eb8e98025041000001</xsd:appinfo>
              <xsd:documentation>Numer partnera biznesowego</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="10" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="SadFunkcjonalnyStanowiskoFinansowe">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">9d207cf15ca611eba6af025041000001</xsd:appinfo>
              <xsd:documentation>Sąd funkcjonalny/Stanowisko finansowe</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="16" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="IDPrzedmiotuUmowy">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">9d207cf25ca611ebb3e3025041000001</xsd:appinfo>
              <xsd:documentation>ID Przedmiotu Umowy</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
