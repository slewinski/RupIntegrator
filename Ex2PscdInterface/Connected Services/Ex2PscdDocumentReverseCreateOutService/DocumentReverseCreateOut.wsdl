          <xsd:appinfo source="http://sap.com/xi/VersionID">1d18ad44622711ebabf6000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element minOccurs="0" name="IDKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929653b8811ebb7d1025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikator żądania</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="RodzajKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929663b8811ebbe05025041000001</xsd:appinfo>
              <xsd:documentation>Typ komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerKomunikatu">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929673b8811eba8c3025041000001</xsd:appinfo>
              <xsd:documentation>Numer komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{3}$" />
                <xsd:maxLength value="3" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="Komunikat">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">a4c929683b8811ebbab2025041000001</xsd:appinfo>
              <xsd:documentation>Tekstowa postać komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="240" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="KorygowanieDokumentu">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">b42c9f6f622811ebcbcd000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="NumerDokumentuRozrachunkow">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">b16c6662622811eb94a7025041000001</xsd:appinfo>
              <xsd:documentation>Numer dokumentu rozrachunków wg kont umów</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="KluczUzgodnienia">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">b16c6663622811ebaaa7025041000001</xsd:appinfo>
              <xsd:documentation>Klucz uzgodnienia dla księgowości KG</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DocumentReverseCreateResponse">
        <xsd:annotation>
