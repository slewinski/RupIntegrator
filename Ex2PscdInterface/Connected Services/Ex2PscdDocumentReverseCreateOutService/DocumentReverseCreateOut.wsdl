  <wsdl:documentation />
  <wsp:UsingPolicy wsdl:required="true" />
  <wsp:Policy wsu:Id="OP_DocumentReverseCreateOut" />
  <wsdl:types>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:DocumentReverseCreate" xmlns:p6="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:DocumentReverseCreate" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:import namespace="urn:ms.gov.pl:EX2PSCD:Common" />
      <xsd:element name="DocumentReverseCreateRequest" type="p6:DocumentReverseCreateRequest" />
      <xsd:element name="DocumentReverseCreateResponse" type="p6:DocumentReverseCreateResponse" />
    </xsd:schema>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:Common" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:complexType name="Komunikaty">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">cbc364503b8811ebb319000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element minOccurs="0" maxOccurs="unbounded" name="Komunikat" type="Komunikat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Admin">
        <xsd:annotation>
          <xsd:documentation xml:lang="EN">Dane administracyjne dot. żądania</xsd:documentation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">256562f8622711eb82c8000006d9f6a6</xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="JednostkaGospodarcza">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300d3b8511ebab5d025041000001</xsd:appinfo>
              <xsd:documentation>Numer jednostki gospodarczej (4 cyfry)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{4}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="IDKomunikatu" type="xsd:string">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300e3b8511ebae7d025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikacja komunikatu</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="IDSystemMerytorycznego" type="xsd:string">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e866300f3b8511eba995025041000001</xsd:appinfo>
              <xsd:documentation>Identyfikacja systemu merytorycznego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="UtworzonyData">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e86630103b8511ebbb15025041000001</xsd:appinfo>
              <xsd:documentation>Data utworzenia komunikatu (format YYYYMMDD)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{8}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="UtworzonyGodz">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">e86630113b8511eba551025041000001</xsd:appinfo>
              <xsd:documentation>Godzina utworzenia komunikatu (format HHMMSS)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{6}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Uzytkownik">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">5fbdeefa571211ebbbed025041000001</xsd:appinfo>
              <xsd:documentation>Nazwa użytkownika na systemie ZSRK ERP FI</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\w{1" />
                <xsd:pattern value="12}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Haslo">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">5fbdeefb571211eba86d025041000001</xsd:appinfo>
              <xsd:documentation>Zaszyfrowane hasło użytkownika</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^[-A-Za-z0-9+\/]*={0" />
                <xsd:pattern value="3}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DocumentReverseCreateRequest">
        <xsd:annotation>
          <xsd:appinfo source="http://sap.com/xi/VersionID">c2338e13622811eba4a5000006d9f6a6</xsd:appinfo>
