        </xsd:annotation>
        <xsd:sequence>
          <xsd:element minOccurs="0" name="NumerDokumentuRozrachunkow">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">5dab05825c0311eb99d6025041000001</xsd:appinfo>
              <xsd:documentation>Numer dokumentu rozrachunków wg kont umów</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="12" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Komunikaty" type="Komunikaty">
            <xsd:annotation>
              <xsd:appinfo source="http://sap.com/xi/TextID">84479a0f5c0311ebc461025041000001</xsd:appinfo>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
