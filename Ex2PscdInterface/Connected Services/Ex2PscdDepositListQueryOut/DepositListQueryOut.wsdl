<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:p2="urn:ms.gov.pl:EX2PSCD:DepositListQueryOut" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy" xmlns:p1="urn:ms.gov.pl:EX2PSCD:DepositListQuery" name="DepositListQueryOut" targetNamespace="urn:ms.gov.pl:EX2PSCD:DepositListQuery" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
  <wsdl:documentation />
  <wsp:UsingPolicy wsdl:required="true" />
  <wsp:Policy wsu:Id="OP_DepositListQueryOut" />
  <wsdl:types>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:Common" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:complexType name="DepositListQueryResponse">
        <xsd:sequence>
          <xsd:element minOccurs="0" maxOccurs="unbounded" name="DepozytyWB" type="DepozytyWB" />
          <xsd:element name="Komunikaty" type="Komunikaty" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DepozytyWB">
        <xsd:sequence>
          <xsd:element name="DepozytPozycjaWB" type="DepozytPozycjaWB" />
          <xsd:element minOccurs="0" name="DepozytDanePartner" type="Partner" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DepositListQueryRequest">
        <xsd:sequence>
          <xsd:element name="Admin" type="Admin" />
          <xsd:element name="DepozytZapytanieWB" type="DepozytZapytanieWB" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DepozytPozycjaWB">
        <xsd:sequence>
          <xsd:element name="JednostkaGospodarcza" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Sąd</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="NrTransWB" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer transakcji w wyciągu bankowym</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="MikroRach" type="xsd:string" />
          <xsd:element name="Kwota" type="xsd:string" />
          <xsd:element name="Waluta" type="xsd:string" />
          <xsd:element name="dataWB" type="xsd:string" />
          <xsd:element name="dataWalutyWB" type="xsd:string" />
          <xsd:element name="Tresc" type="xsd:string" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Komunikaty">
        <xsd:sequence>
          <xsd:element minOccurs="0" maxOccurs="unbounded" name="Komunikat" type="Komunikat" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Admin">
        <xsd:annotation>
          <xsd:documentation xml:lang="EN">Dane administracyjne dot. żądania</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="JednostkaGospodarcza">
            <xsd:annotation>
              <xsd:documentation>Numer jednostki gospodarczej (4 cyfry)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{4}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="IDKomunikatu" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Identyfikacja komunikatu</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="IDSystemMerytorycznego" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Identyfikacja systemu merytorycznego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="UtworzonyData">
            <xsd:annotation>
              <xsd:documentation>Data utworzenia komunikatu (format YYYYMMDD)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{8}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="UtworzonyGodz">
            <xsd:annotation>
              <xsd:documentation>Godzina utworzenia komunikatu (format HHMMSS)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{6}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Uzytkownik">
            <xsd:annotation>
              <xsd:documentation>Nazwa użytkownika na systemie ZSRK ERP FI</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\w{1" />
                <xsd:pattern value="12}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="Haslo">
            <xsd:annotation>
              <xsd:documentation>Zaszyfrowane hasło użytkownika</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^[-A-Za-z0-9+\/]*={0" />
                <xsd:pattern value="3}$" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Partner">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="IDPartnera" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer partnera biznesowego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="TypPartnera" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Typ partnera biznesowego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="Imie" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Imię</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="Nazwisko" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Nazwisko 1</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NazwaOrganizacji1" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Nazwa organizacji 1</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NazwaOrganizacji2" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Nazwa organizacji 2</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NazwaOrganizacji3" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Nazwa organizacji 3</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NazwaOrganizacji4" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Nazwa organizacji 4</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="PESEL" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer PESEL</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NIP" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer NIP</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="KW_RBN" type="xsd:string" />
          <xsd:element minOccurs="0" name="AdresPartner" type="AdresPartner">
            <xsd:annotation>
              <xsd:documentation>Adres partnera biznesowego</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="RachunekBankowy" type="RachunekBankowy" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Komunikat">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="IDKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Identyfikator żądania</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="RodzajKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Typ komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="1" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerKomunikatu">
            <xsd:annotation>
              <xsd:documentation>Numer komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:pattern value="^\d{3}$" />
                <xsd:maxLength value="3" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element minOccurs="0" name="Komunikat">
            <xsd:annotation>
              <xsd:documentation>Tekstowa postać komunikatu</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="240" />
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="AdresPartner">
        <xsd:annotation>
          <xsd:documentation xml:lang="EN">Adres partnera biznesowego</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="Kraj" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Kraj</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="Miasto" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Miasto</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="KodPocztowy" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Kod pocztowy</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="Ulica" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Ulica</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerDomu" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer domu1</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element minOccurs="0" name="NumerDomu2" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Numer domu2</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DepozytZapytanieWB">
        <xsd:sequence>
          <xsd:element name="dataWBOd" type="xsd:string" />
          <xsd:element name="dataWBDo" type="xsd:string" />
          <xsd:element name="JednostkaOrganizacyjna" type="xsd:string" />
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="RachunekBankowy">
        <xsd:sequence>
          <xsd:element name="Kraj" type="xsd:string" />
          <xsd:element name="NumerBanku" type="xsd:string" />
          <xsd:element name="KontoBankowe" type="xsd:string" />
          <xsd:element name="KodKontrolny" type="xsd:string" />
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
    <xsd:schema xmlns="urn:ms.gov.pl:EX2PSCD:DepositListQueryOut" xmlns:p1="urn:ms.gov.pl:EX2PSCD:Common" targetNamespace="urn:ms.gov.pl:EX2PSCD:DepositListQueryOut" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:import namespace="urn:ms.gov.pl:EX2PSCD:Common" />
      <xsd:element name="DepositListQueryRequest" type="p1:DepositListQueryRequest" />
      <xsd:element name="DepositListQueryResponse" type="p1:DepositListQueryResponse" />
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="DepositListQueryRequest">
    <wsdl:documentation />
    <wsdl:part name="DepositListQueryRequest" element="p2:DepositListQueryRequest" />
  </wsdl:message>
  <wsdl:message name="DepositListQueryResponse">
    <wsdl:documentation />
    <wsdl:part name="DepositListQueryResponse" element="p2:DepositListQueryResponse" />
  </wsdl:message>
  <wsdl:portType name="DepositListQueryOut">
    <wsdl:documentation />
    <wsdl:operation name="DepositListQueryOut">
      <wsdl:documentation />
      <wsp:Policy>
        <wsp:PolicyReference URI="#OP_DepositListQueryOut" />
      </wsp:Policy>
      <wsdl:input message="p1:DepositListQueryRequest" />
      <wsdl:output message="p1:DepositListQueryResponse" />
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="DepositListQueryOutBinding" type="p1:DepositListQueryOut">
    <binding transport="http://schemas.xmlsoap.org/soap/http" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
    <wsdl:operation name="DepositListQueryOut">
      <operation soapAction="http://sap.com/xi/WebService/soap1.1" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      <wsdl:input>
        <body use="literal" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      </wsdl:input>
      <wsdl:output>
        <body use="literal" xmlns="http://schemas.xmlsoap.org/wsdl/soap/" />
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
</wsdl:definitions>