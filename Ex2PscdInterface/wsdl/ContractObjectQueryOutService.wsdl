            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:complexType name="ContractObjectQueryResponse">
                <xsd:annotation>
                    <xsd:appinfo source="http://sap.com/xi/VersionID">8cfa7af58e2111eba8ae000006d9f6a6</xsd:appinfo>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Sygnatura" type="SygnaturaIdentyfikacja" minOccurs="0" maxOccurs="unbounded">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">8c4ad7e88e2111ebab68025041000001</xsd:appinfo>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Komunikaty" type="Komunikaty">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">8c4ad7e98e2111eb9d9c025041000001</xsd:appinfo>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SygnaturaDefinicja">
                <xsd:annotation>
                    <xsd:appinfo source="http://sap.com/xi/VersionID">628716d7917211ebc075000006d9f6a6</xsd:appinfo>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="JednostkaGospodarcza" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e0913175cae11ebbbc6025041000001</xsd:appinfo>
                            <xsd:documentation>Jednostka gospodarcza</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="4"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="NumerWydzialuISekcji" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e0913185cae11ebb475025041000001</xsd:appinfo>
                            <xsd:documentation>Numer wydziału i sekcji</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="10"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Repertorium" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e0913195cae11ebb01a025041000001</xsd:appinfo>
                            <xsd:documentation>Repertorium</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="10"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="KolejnyNumerSprawy" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131a5cae11eba8ac025041000001</xsd:appinfo>
                            <xsd:documentation>Kolejny numer sprawy</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="8"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Rok" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131b5cae11eb8da3025041000001</xsd:appinfo>
                            <xsd:documentation>Rok</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:pattern value="^\d{4}$"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="RodzajSprawy" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131c5cae11ebb4b3025041000001</xsd:appinfo>
                            <xsd:documentation>Rodzaj sprawy</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="5"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="IloscTomow" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131d5cae11eba5d2025041000001</xsd:appinfo>
                            <xsd:documentation>Ilość tomów</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:pattern value="^\d{3}$"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PodrodzajSprawy" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131e5cae11ebaeb1025041000001</xsd:appinfo>
                            <xsd:documentation>Podrodzaj sprawy</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="4"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="IDPrzedmiotuUmowy" minOccurs="0">
                        <xsd:annotation>
                            <xsd:appinfo source="http://sap.com/xi/TextID">0e09131f5cae11ebc1ae025041000001</xsd:appinfo>
                            <xsd:documentation>Klucz identyfik. przedmiotu umowy</xsd:documentation>
                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
