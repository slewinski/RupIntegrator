                        </xsd:annotation>
                        <xsd:simpleType>
                            <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="240"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="TabelaDokumentowPlanuRat">
                <xsd:annotation>
                    <xsd:appinfo source="http://sap.com/xi/VersionID">c72f29f65bcf11eb9980000006d9f6a6</xsd:appinfo>
                </xsd:annotation>
                <xsd:sequence>
