            <xsd:complexType name="InstalmentPlanCreateRequest">
                <xsd:annotation>
                    <xsd:appinfo source="http://sap.com/xi/VersionID">f3775c555bcf11ebc497000006d9f6a6</xsd:appinfo>
                </xsd:annotation>
                <xsd:sequence>
                    <xsd:element name="Admin" type="Admin"/>
                    <xsd:element name="KodWaluty" type="xsd:string"/>
                    <xsd:element name="KluczUzgodnienia" type="xsd:string" minOccurs="0"/>
